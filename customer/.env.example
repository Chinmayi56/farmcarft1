# Optional for local development; Vite's /api proxy (see vite.config.js) is
# used by default and forwards to http://127.0.0.1:8000.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Required in production (e.g. on Vercel), where there is no dev proxy —
# point this at your deployed FastAPI backend's API prefix:
# VITE_API_BASE_URL=https://your-backend-host.example.com/api
