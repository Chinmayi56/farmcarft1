# Farm-Craft Backend Environment Configuration
# Copy this file to .env and adjust values for your environment.

# --- Application ---
APP_NAME=Farm-Craft API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api

# --- PostgreSQL Database ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

# Individual DB components (used only if DATABASE_URL is not set)
DB_USER=farmcraft
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5433
DB_NAME=farmcraft_db

# --- SQLAlchemy Engine ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- CORS ---
# Comma-separated list of allowed origins. Keep the local dev origins and
# add your deployed Customer/Admin domains alongside them, e.g.:
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://cfvu89.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- JWT / Authentication ---
# Generate a strong random value, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OTP (demo Customer login) ---
OTP_EXPIRE_MINUTES=5
OTP_DEMO_CODE=1234
OTP_MAX_ATTEMPTS=5

# --- Initial demo Admin account (used only by the Alembic seed migration) ---
DEMO_ADMIN_EMAIL=admin@farmcraft.com
DEMO_ADMIN_PASSWORD=admin123

# --- Company information (centralized) ---
COMPANY_NAME=FARM CRAFT
CONTACT_PERSON=VARADA VIJAYAKRISHNA
PRIMARY_PHONE=+919440436868
SECONDARY_PHONE=+919490436868
WHATSAPP_NUMBER=919440436868
COMPANY_EMAIL=farmcraft68@gmail.com
COMPANY_ADDRESS=1-23A, Swaraj Tractor Showroom, Palakonda, Manyam District, Andhra Pradesh
COMPANY_PINCODE=532440

# --- Contact form email delivery ---
# SMTP_PASSWORD must be set in the real .env only — never commit it.
CONTACT_RECIPIENT_EMAIL=farmcraft68@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=farmcraft68@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=farmcraft68@gmail.com
SMTP_FROM_NAME=Farm Craft
SMTP_USE_TLS=true
